# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.

# Required — server-side only. Read by app/config.py via pydantic-settings.
# Never exposed to any client response or log line.
# Get a free key (no credit card required) at https://aistudio.google.com
GOOGLE_API_KEY=

# Which Gemini model to call. gemini-2.5-flash is covered by Google AI
# Studio's free tier (check the AI Studio dashboard for your account's
# live rate limits — they vary by account age and region).
GEMINI_MODEL=gemini-2.5-flash

# Comma-separated list of origins allowed to call this API
# (e.g. your Vercel frontend URL and local dev server).
# If you're opening index.html via a local static server (e.g. VS Code
# "Live Server", `python -m http.server`, etc.), add that origin here —
# e.g. http://127.0.0.1:5500 or http://localhost:8080. Opening
# index.html directly as a file:// URL will NOT work — the browser
# sends no Origin header CORS can match, so it must be served over http.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,http://localhost:5500
